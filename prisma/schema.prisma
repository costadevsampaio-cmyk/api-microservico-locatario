generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Status {
  ATIVO
  INATIVO
}

model Locatario {
  id        BigInt @id
  email     String @unique
  endereco  String
  telefone  String?
  status    Status @default(ATIVO)

  pessoaFisica   PessoaFisica?
  pessoaJuridica PessoaJuridica?

  @@map("locatario")
}

model PessoaFisica {
  locatarioId   BigInt @id
  nome          String
  cpf           String @unique
  rg            String?
  estadoCivil   String?
  profissaoRamo String?

  locatario Locatario @relation(fields: [locatarioId], references: [id], onDelete: Cascade)

  @@map("pessoafisica")
}

model PessoaJuridica {
  locatarioId       BigInt @id
  razaoSocial       String
  cnpj              String @unique
  inscricaoEstadual String?

  locatario Locatario @relation(fields: [locatarioId], references: [id], onDelete: Cascade)

  @@map("pessoajuridica")
}